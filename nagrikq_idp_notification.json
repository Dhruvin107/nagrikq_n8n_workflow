    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nif (!body.eventId || !body.application) {\n  throw new Error('Invalid IDP event payload: eventId and application object required.');\n}\nreturn {\n  eventId: body.eventId,\n  applicationId: body.application.id,\n  applicationNumber: body.application.applicationNumber,\n  serviceName: body.application.serviceName || 'International Driving Permit (IDP)',\n  status: body.application.status || 'SUBMITTED',\n  userId: body.application.userId,\n  phone: body.application.phone || '',\n  submittedAt: body.application.submittedAt || new Date().toISOString(),\n  recipientTelegramChatId: body.recipientTelegramChatId || null,\n  timestamp: body.timestamp || new Date().toISOString()\n};"
      },
      "id": "d2cabd50-0052-4377-9e78-95fc64aa8718",
      "name": "Validate & Extract Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        -1968,
        448
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ Boolean($json.recipientTelegramChatId) }}",
              "value2": true
            }
          ]
        }
      },
      "id": "acc86569-dc51-4d3b-83a0-ab2abe94f10b",
      "name": "Has Linked Telegram Chat ID?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        -1744,
        448
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot8874803375:AAECsJ9jyBd8d-LlcNJMEpt1ZyYGqYbkHzQ/sendMessage",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "=={{ $json.recipientTelegramChatId }}"
            },
            {
              "name": "parse_mode",
              "value": "Markdown"
            },
            {
              "name": "text",
              "value": "==🔔 *NagrikQ IDP Creation Notification*\nYour application has been created successfully!\n• *Application No*: `{{ $json.applicationNumber }}`\n• *Service*: {{ $json.serviceName }}\n• *Status*: `{{ $json.status }}`\n• *Date*: {{ $json.submittedAt.split('T')[0] }}\n🔗 *View Application Details:*\nhttp://localhost:5173/user/applications"
            }
          ]
        },
        "options": {
          "allowUnauthorizedCerts": true
        }
      },
      "id": "374acc45-ea2d-4740-9fa8-26e283b7e497",
      "name": "Send Telegram Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
