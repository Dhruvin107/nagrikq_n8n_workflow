        400
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"delivered\": true,\n  \"eventId\": \"{{ $('Validate & Extract Payload').item.json.eventId }}\",\n  \"chatId\": \"{{ $('Validate & Extract Payload').item.json.recipientTelegramChatId }}\",\n  \"message\": \"Telegram notification sent successfully.\"\n}",
        "options": {}
      },
